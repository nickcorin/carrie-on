{
  "openapi": "3.1.0",
  "info": {"title": "Tokenmaxxer desktop connection", "version": "1.0.0"},
  "servers": [{"url": "http://127.0.0.1:8766"}],
  "paths": {
    "/api/menu": {
      "get": {
        "summary": "Refresh connection, usage, and queue summary together",
        "description": "A read-only poll containing a bounded desktop handshake and current usage and queue observations. A failed usage or queue read returns null and its error while preserving the other observations. Clients should advance their last complete update time only when both usage and queue are present. Requires a trusted loopback client; responses are not cached.",
        "parameters": [{"in": "header", "name": "X-Tokenmaxxer", "required": true, "schema": {"type": "string", "const": "1"}}],
        "responses": {
          "200": {"description": "Complete or partial refresh snapshot", "content": {"application/json": {"schema": {
            "type": "object", "required": ["connected", "usage", "queue", "usage_error", "queue_error"],
            "properties": {
              "connected": {"type": "boolean", "description": "Whether the desktop handshake succeeded during this poll"},
              "usage_error": {"type": ["string", "null"]},
              "queue_error": {"type": ["string", "null"]},
              "usage": {"type": ["object", "null"], "required": ["windows"], "properties": {
                "windows": {"type": "array", "minItems": 1, "items": {
                  "type": "object", "required": ["bucket", "name", "used_percent", "resets_at", "window_minutes"],
                  "properties": {
                    "bucket": {"type": "string"}, "name": {"type": "string"},
                    "used_percent": {"type": "number", "minimum": 0},
                    "resets_at": {"type": "number", "exclusiveMinimum": 0, "description": "Unix time in seconds"},
                    "window_minutes": {"type": ["integer", "null"]}
                  }
                }}
              }},
              "queue": {"type": ["object", "null"], "required": ["count", "paused", "needs_attention"], "properties": {
                "count": {"type": "integer", "minimum": 0}, "paused": {"type": "boolean"},
                "needs_attention": {"type": "integer", "minimum": 0}, "service_installed": {"type": "boolean"},
                "last_check": {"type": ["number", "null"]}, "last_error": {"type": ["string", "null"]}
              }}
            }
          }}}},
          "403": {"description": "Request is not from a trusted local client", "content": {"application/json": {"schema": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}}}}}
        }
      }
    },
    "/api/connection": {
      "get": {
        "summary": "Observe desktop connectivity without opening chats or running inference",
        "description": "Performs a same-user desktop IPC handshake with a three-second timeout. Missing, refused, timed-out, or incompatible connections return connected=false. The observation does not guarantee availability for a later action and does not change the queue. Requires a loopback Host, no foreign Origin or cross-site request, and the local-client header. Responses are not cached.",
        "parameters": [{"in": "header", "name": "X-Tokenmaxxer", "required": true, "schema": {"type": "string", "const": "1"}}],
        "responses": {
          "200": {"description": "Current handshake result", "content": {"application/json": {"schema": {"type": "object", "required": ["connected"], "properties": {"connected": {"type": "boolean"}}}}}},
          "403": {"description": "Request is not from a trusted local client", "content": {"application/json": {"schema": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}}}}}
        }
      }
    }
  }
}
